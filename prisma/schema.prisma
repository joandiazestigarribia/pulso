generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BattleState {
  PENDING
  COMPLETED
}

enum MergeAuditStatus {
  MERGED
  NOOP
  INVALID_SOURCE
}

enum CatalogCurationRuleType {
  ARTIST
}

enum ConversionEventName {
  battle_started
  vote_submitted
  profile_teaser_viewed
  profile_unlock_reached
  auth_prompt_shown
  auth_completed
  merge_completed
  export_started
  export_completed
}

enum UserRole {
  USER
  ADMIN
}

enum PlaylistStatus {
  DRAFT
  PUBLISHED
}

model User {
  id               String            @id
  email            String?           @unique
  passwordHash     String?
  role             UserRole          @default(USER)
  profileCompleted Boolean           @default(false)
  battles          Battle[]
  musicProfile     MusicProfile?
  mergeAudits      MergeAudit[]
  conversionEvents ConversionEvent[]
  profileShares    ProfileShare[]
  playlists        Playlist[]
  playlistAttempts PlaylistAttempt[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Track {
  id           String   @id
  catalogBucket String   @default("general")
  name         String
  artist       String
  albumImage   String
  previewUrl   String?
  previewSource String?
  previewCheckedAt DateTime?
  eloScore     Int      @default(1500)
  battlesCount Int      @default(0)
  bpm          Int
  duration     String
  genre        String
  year         Int
  energy       Float?
  valence      Float?
  danceability Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  battlesAsA Battle[] @relation("BattleTrackA")
  battlesAsB Battle[] @relation("BattleTrackB")
  playlistTracks       PlaylistTrack[]
  guessRoundsAsCorrect GuessRound[]    @relation("GuessRoundCorrectTrack")
  guessRoundsAsDecoy   GuessRound[]    @relation("GuessRoundDecoyTrack")
}

model CatalogCurationRule {
  id        String                  @id @default(cuid())
  type      CatalogCurationRuleType
  pattern   String
  isActive  Boolean                 @default(true)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@index([type, isActive])
  @@unique([type, pattern])
}

model Battle {
  id               String      @id @default(cuid())
  userId           String
  trackAId         String
  trackBId         String
  winnerId         String?
  loserId          String?
  winnerEloChange  Int?
  loserEloChange   Int?
  status           BattleState @default(PENDING)
  createdAt        DateTime    @default(now())
  completedAt      DateTime?
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackA           Track       @relation("BattleTrackA", fields: [trackAId], references: [id], onDelete: Restrict)
  trackB           Track       @relation("BattleTrackB", fields: [trackBId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@index([trackAId, createdAt])
  @@index([trackBId, createdAt])
  @@index([status, createdAt])
}

model MusicProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  summary             String?
  dominantGenre       String?
  genreVarietyScore   Float?
  averageEnergy       Float?
  averageValence      Float?
  averageDanceability Float?
  decadeDistribution  Json?
  generatedFromVotes  Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfileShare {
  id                    String   @id @default(cuid())
  userId                String
  sharerName            String?
  personaName           String
  personaCodename       String  @default("SO-00")
  personaAssetFile      String
  headline              String
  description           String
  completedBattlesCount Int
  generatedFromVotes    Int
  dominantGenres        Json
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MergeAudit {
  id                String           @id @default(cuid())
  sourceAnonymousId String?
  targetUserId      String
  movedBattles      Int              @default(0)
  movedPlaylists    Int              @default(0)
  movedAttempts     Int              @default(0)
  status            MergeAuditStatus
  createdAt         DateTime         @default(now())
  user              User             @relation(fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
  @@index([sourceAnonymousId, createdAt])
}

model ConversionEvent {
  id          String              @id @default(cuid())
  eventName   ConversionEventName
  userId      String?
  anonymousId String?
  battleId    String?
  variant     String?
  metadata    Json?
  createdAt   DateTime            @default(now())
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventName, createdAt])
  @@index([userId, createdAt])
  @@index([anonymousId, createdAt])
}

model Playlist {
  id          String            @id @default(cuid())
  ownerUserId String
  title       String
  status      PlaylistStatus    @default(DRAFT)
  roundCount  Int               @default(15)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  owner       User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  tracks      PlaylistTrack[]
  rounds      GuessRound[]
  attempts    PlaylistAttempt[]

  @@index([ownerUserId, createdAt])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  position   Int
  createdAt  DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@unique([playlistId, trackId])
  @@index([playlistId, position])
}

model GuessRound {
  id             String   @id @default(cuid())
  playlistId     String
  roundIndex     Int
  correctTrackId String
  decoyTrackId   String
  createdAt      DateTime @default(now())
  playlist       Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  correctTrack   Track    @relation("GuessRoundCorrectTrack", fields: [correctTrackId], references: [id], onDelete: Restrict)
  decoyTrack     Track    @relation("GuessRoundDecoyTrack", fields: [decoyTrackId], references: [id], onDelete: Restrict)

  @@unique([playlistId, roundIndex])
}

model PlaylistAttempt {
  id           String                  @id @default(cuid())
  playlistId   String
  playerUserId String
  nickname     String
  score        Int                     @default(0)
  totalRounds  Int
  completedAt  DateTime?
  createdAt    DateTime                @default(now())
  playlist     Playlist                @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  player       User                    @relation(fields: [playerUserId], references: [id], onDelete: Cascade)
  answers      PlaylistAttemptAnswer[]

  @@unique([playlistId, playerUserId])
  @@index([playlistId, score])
}

model PlaylistAttemptAnswer {
  id            String          @id @default(cuid())
  attemptId     String
  roundIndex    Int
  chosenTrackId String
  correct       Boolean
  attempt       PlaylistAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, roundIndex])
}
